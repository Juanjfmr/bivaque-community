node_modules/
.next/
dist/
coverage/
*.tsbuildinfo
playwright-report/
test-results/
.visual/
dev-server.log
dev-server.pid
.env
.env.*
!.env.example

# Local agent evidence and run state
.omo/

# Local run logs and pid files from dev/E2E diagnostics
work/

# Transient diagnostics from E2E / db runs at the repo root (never repo state)
e2e-*.log
e2e-*.xml
e2e-*.json
junit-results.xml
playwright-install.log
supabase-start.log
supabase-start.err
supabase-env.txt
# accidental shell redirects that created names with a trailing space
e2e-junit.xml\ 
e2e-results.json\ 

# Claude Code managed worktrees (each contains a full node_modules clone)
.claude/worktrees/

# Reasonix desktop host runtime metadata — not repo state
.reasonix/

# Vercel project linkage and downloaded local runtime metadata
.vercel/

# JetBrains / Android Studio local IDE state (workspace.xml, caches, .iml)
# Nunca commitar — paths e caches são específicos da máquina.
.idea/
*.iml

# Projeto nativo gerado por `expo prebuild` e saída dos builds locais do mobile.
# Regenerável; nunca é fonte. O .cxx/ do CMake ainda faz o Biome tentar formatar
# JSON de build — por isso o mesmo caminho está excluído em biome.json.
apps/mobile/android/
apps/mobile/ios/
apps/mobile/dist-android/
apps/mobile/dist-ios/
apps/mobile/*.apk
apps/mobile/build-log-*.txt

# Store local do pnpm: ~82 mil arquivos, nunca versionado.
.pnpm-store/
