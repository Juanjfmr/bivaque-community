{
  "name": "bivaque-native-beta",
  "version": "0.2.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.mjs",
    "assets:copy": "node scripts/copy-assets.mjs",
    "bundle:android": "expo export --platform android",
    "prebuild": "expo prebuild --platform android --clean --no-install",
    "verify:ui": "node --test tests/*.test.mjs"
  },
  "dependencies": {
    "expo": "~56.0.0",
    "expo-router": "~56.2.22",
    "expo-constants": "~56.0.27",
    "expo-linking": "~56.0.19",
    "expo-status-bar": "~56.0.4",
    "expo-haptics": "~56.0.3",
    "expo-image-picker": "~56.0.25",
    "@expo/vector-icons": "^15.0.3",
    "@react-native-async-storage/async-storage": "2.2.0",
    "react": "19.2.3",
    "react-native": "0.85.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-gesture-handler": "~2.31.1",
    "expo-file-system": "~56.0.11",
    "expo-font": "~56.0.7",
    "@expo/ui": "~56.0.26",
    "expo-image": "~56.0.13",
    "react-native-reanimated": "4.3.1",
    "react-native-worklets": "0.8.3"
  },
  "devDependencies": {
    "@types/react": "~19.2.14",
    "typescript": "~6.0.3",
    "babel-preset-expo": "~56.0.0"
  }
}
