{
  "expo": {
    "name": "Bivaque — Expo UI Beta",
    "slug": "bivaque-expo-ui-beta",
    "version": "0.2.0",
    "orientation": "portrait",
    "scheme": "bivaque-ui-beta",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "android": {
      "package": "com.bivaque.community.expuibeta",
      "versionCode": 2,
      "edgeToEdgeEnabled": true,
      "adaptiveIcon": {
        "backgroundColor": "#f3f5f6"
      },
      "permissions": []
    },
    "ios": {
      "bundleIdentifier": "com.bivaque.community.nativebeta",
      "supportsTablet": false
    },
    "plugins": [
      "expo-router",
      [
        "expo-image-picker",
        {
          "photosPermission": "Escolha fotos para criar seus anúncios no Bivaque.",
          "cameraPermission": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": false
    }
  }
}
