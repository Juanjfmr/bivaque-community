{
  "$schema": "https://opencode.ai/config.json",

  // 23/10/2026, autorizado pelo dono: o implementador reseta o banco LOCAL e roda as
  // provas da propria frente, uma de cada vez, pela fila (scripts/agents/prova-fila.mjs).
  // So os dois comandos exatos abaixo, sem curinga (um `*` deixaria colar `--linked` no fim);
  // qualquer outro `db reset` continua pedindo confirmacao
  // (config global) e `--linked` (producao) continua proibido.
  "permission": {
    "bash": {
      "node scripts/agents/prova-fila.mjs -- npx supabase db reset --local": "allow",
      "node scripts/agents/prova-fila.mjs -- npx supabase db reset --local --no-seed": "allow"
    }
  },

  // Config de projeto. Mescla sobre `~/.config/opencode/opencode.json`.
  // MCP custa contexto em TODA request — só liga aqui o que este repo usa.

  "mcp": {
    "supabase": {
      "type": "remote",
      "url": "https://mcp.supabase.com/mcp",
      "enabled": true
    },

    // Desligado de propósito. O repo já tem loop determinístico de browser em
    // `scripts/visual/loop.mjs` (captura + auditoria + artefatos em .visual/).
    // Dirigir o browser por fora dele é o gatilho do perfil fantasma "Visual
    // Capture" — ver a seção de armadilhas no AGENTS.md.
    "playwright": {
      "type": "local",
      "command": ["npx", "@playwright/mcp@latest"],
      "enabled": false
    },

    // Grafo de código local — codebase-memory-mcp 0.9.1-rc.1 (instalado
    // manualmente em ~/.local/bin, verificado via SHA-256 + gh attestation
    // verify). Consulta estrutural que o agente chama sozinho: trace_path,
    // detect_changes, search_graph, get_architecture. Indexa em
    // ~/.cache/codebase-memory-mcp; sem rede, sem API key. Atualização do
    // binário é manual (re-baixar a release); o índice se atualiza sozinho.
    "codebase-memory-mcp": {
      "type": "local",
      "command": ["C:\\Users\\juana\\.local\\bin\\codebase-memory-mcp.exe"],
      "enabled": true
    },

    // Debugger de browser (console, rede, performance, DOM). Complementa o
    // loop visual: loop.mjs FOTOGRAFA, este DEBUGA — não substitui nem
    // conflita. Restrições: (1) nunca usar para dirigir o loop visual —
    // browser de captura é só via scripts/visual/loop.mjs; (2) não navegar
    // no app local durante janelas db:reset → test:db (gatilho do perfil
    // fantasma "Visual Capture" — ver armadilhas no AGENTS.md).
    //
    // Desligado em 23/10/2026: cada `opencode run` sobe a própria cadeia
    // (npx + node, ~230 MB) e ela fica viva depois que a execução termina. Com
    // execuções paralelas do lote 4 a RAM livre chegou a 0,3 GB, e as tarefas
    // de implementação não usam o navegador. Religar só numa sessão que vá
    // depurar o browser, e derrubar a cadeia ao terminar.
    "chrome-devtools": {
      "type": "local",
      "command": ["npx", "chrome-devtools-mcp@latest"],
      "enabled": false
    }
  }
}
