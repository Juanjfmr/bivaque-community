{
  "name": "mobile",
  "version": "0.0.0",
  "private": true,
  "main": "expo-router/entry",
  "packageManager": "pnpm@11.18.0",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "export:android": "expo export --platform android --output-dir dist-android",
    "export:ios": "expo export --platform ios --output-dir dist-ios",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "biome check .",
    "test": "vitest run"
  },
  "dependencies": {
    "@bivaque/tokens": "workspace:*",
    "@react-native-async-storage/async-storage": "3.1.1",
    "@supabase/supabase-js": "^2.117.2",
    "expo": "~57.0.25",
    "expo-build-properties": "~57.0.22",
    "expo-constants": "~57.0.19",
    "expo-file-system": "~57.0.7",
    "expo-linking": "~57.0.11",
    "expo-router": "~57.0.23",
    "expo-secure-store": "^57.0.4",
    "expo-status-bar": "~57.0.1",
    "react": "19.3.0",
    "react-native": "0.87.1",
    "react-native-safe-area-context": "5.10.0",
    "react-native-screens": "~4.28.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.7",
    "@types/react": "^19.3.0",
    "react-native-monorepo-config": "^0.4.0",
    "typescript": "~5.9.2",
    "vitest": "^4.1.0"
  }
}
