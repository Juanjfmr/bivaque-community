# Supabase server-side configuration (never exposed to the browser)
SUPABASE_URL="https://<project>.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="<service_role_key>"

# Supabase browser configuration (Next public env, exposed to the client)
NEXT_PUBLIC_SUPABASE_URL="https://<project>.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="<anon_key>"

# Portal da Transparência API
PORTAL_DADOS_API_KEY="<chave-api-dados>"

# Upstash Redis (rate limit + Portal circuit breaker). Nunca valores reais aqui.
UPSTASH_REDIS_REST_URL="https://<upstash>.upstash.io"
UPSTASH_REDIS_REST_TOKEN="<upstash_token>"

# Sentry (rastreamento de erro). Nunca valores reais aqui; o DSN é o único que
# o SDK lê no runtime — sem ele o Sentry fica desligado.
SENTRY_DSN="https://<key>@<org>.ingest.sentry.io/<project>"
SENTRY_ORG="<org>"
SENTRY_PROJECT="<project>"

# Bridge do worker do outbox (pg_cron -> Next). O endpoint é a URL pública da
# aplicação e o segredo é um token opaco, nunca em commit. Sem os dois, o job
# do pg_cron é um no-op seguro.
OUTBOX_WORKER_ENDPOINT="https://<app>.vercel.app"
OUTBOX_WORKER_SECRET="<outbox-worker-secret>"

# Canal de suporte do piloto (nunca um endereço real em arquivo rastreado)
NEXT_PUBLIC_SUPPORT_EMAIL="<<DEFINIR>>"

# Conta de teste do probe de RLS (usuário comum; o probe NUNCA usa service_role)
RLS_PROBE_EMAIL="<email-de-teste>"
RLS_PROBE_PASSWORD="<senha-de-teste>"

# E-mail transacional (Resend, via outbox da D1). A chave vem do provedor e
# nunca entra em commit; sem ela o worker do outbox não envia e-mail.
RESEND_API_KEY="<resend-api-key>"

# Curadoria do guia por IA (DeepSeek). Fica desligada ate a governanca LGPD e
# o contrato com o fornecedor estarem fechados. Nunca valores reais aqui.
DEEPSEEK_API_KEY="<deepseek-api-key>"
DEEPSEEK_BASE_URL="https://api.deepseek.com/chat/completions"
DEEPSEEK_MODEL="deepseek-chat"
BIVAQUE_AI_CURATION_ENABLED="false"
